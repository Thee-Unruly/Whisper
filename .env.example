# OpenRouter API Key for transcript LLM correction
OPENROUTER_API_KEY=your_openrouter_api_key_here

# PostgreSQL / pgvector Database settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=transcripts_agile
PGUSER=postgres
PGPASSWORD=postgres

# pgAdmin Login Credentials (for Docker container)
PGADMIN_EMAIL=admin@signal.local
PGADMIN_PASSWORD=admin
